# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง (.env ถูก gitignore ไว้ ห้าม commit)
# บน Railway ตั้งค่าเหล่านี้ในหน้า Variables แทน — ตัวแปร MYSQL* จะถูก inject ให้อัตโนมัติ
# เมื่อเชื่อม service MySQL ไว้ในโปรเจกต์เดียวกัน

# ---- ฐานข้อมูล MySQL (ใช้ร่วมกันทั้ง PHP และ decision_tree.py) ----
MYSQLHOST=127.0.0.1
MYSQLPORT=3306
MYSQLUSER=root
MYSQLPASSWORD=
MYSQLDATABASE=futureway

# ---- Google OAuth (https://console.cloud.google.com -> Credentials -> OAuth client ID) ----
GOOGLE_CLIENT_ID=

# ---- รายชื่อ username ที่เป็นผู้ดูแลระบบ คั่นด้วยลูกน้ำ ----
ADMIN_USERS=

# ---- token สำหรับรัน php/migrate.php ผ่านเว็บ (ไม่ต้องตั้งถ้ารันจาก CLI) ----
MIGRATE_TOKEN=

# ---- path ของ Python (ไม่ต้องตั้งถ้ามี venv/ ในโปรเจกต์ หรือ python3 อยู่ใน PATH) ----
# PYTHON_BIN=/usr/bin/python3

# ---- แสดงข้อความ debug ตอน container เริ่มทำงาน (ค่าว่าง = ปิด) ----
# DEBUG_ENTRYPOINT=1
